server {
    listen ${PORT};
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Proxy API calls to Spring Boot backend
    location /api/ {
        proxy_pass ${BACKEND_URL};
        # Cloud Run (Google Frontend) face routing dupa antetul Host.
        # Trebuie trimis domeniul BACKEND-ULUI, nu cel al frontend-ului
        # ($host), altfel requestul e respins (404/403) inainte sa ajunga la Spring.
        proxy_set_header Host ${BACKEND_HOST};
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}